#include<stdio.h>
int main()
{
	int i=2,j, n;
	
	printf("Enter n:");
	scanf("%d", &n);
	
	for(i=2;i<=n; i++)
	{
		for(j=2;j<=i/2;j++)
		{
			if(i%j==0)		//condition for composite numbers
			{
				break;		
			}
		}
		
		if(j>i/2)		//the divisors that are not composite are prime
		{
			printf("%d\n",i);
		}
	}
	return 0;
}
