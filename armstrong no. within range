#include<stdio.h>
#include<math.h>

int main()
{
	int i, num, temp, dig, rem;
	double res;
	
	
	for(i=1;i<=1000;i++)
	{
		dig=0;
		res=0.0;
	
		temp=i;
	
	while(temp!=0)
	{
		temp/=10;
		dig++;
	}
	
	temp=i;
	
	while(temp!=0)
	{
		rem=temp%10;
		res+=pow(rem, dig);
		temp/=10;
	}

	
	if((int)res==i)
	{
		printf("%d\n", i);
	}
}
	
	return 0;
}
