#include<stdio.h>
#include<string.h>

int main()
{
	char name[100];
	char rev[100];
	
	printf("Enter a string:");
	scanf("%s", name);		//taking the string input from user
	
	int len=strlen(name);	
	
	for(int i=0; i<len; i++)
	{
		 rev[i]=name[len-1-i];
	}
	rev[len]='\0';
	
	printf("String: %s\n", name);
	
	printf("Reversed String: %s\n", rev);
	
	int cmp=strcmp(rev, name);
	
	if(cmp==0)
	{
		printf("The string is palindrome!");
	}
	else
	{
		printf("The string is not palindrome!");
	}
	
	return 0;
}
	

