#include<stdio.h>
int main()
{
	
	char ch;
	
	printf("Enter a character:");		//taking marks as input
	scanf("%c", &ch);
	
	//checking for uppercase as per ASCII
	
	if (ch>='A' && ch<='Z'){
		printf("The entered character is in uppercase!");
	}else{
		printf("The entered character is not in uppercase!");
}
	
	
	return 0;
}
