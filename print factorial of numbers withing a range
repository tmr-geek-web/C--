#include<stdio.h>
int main()
{
	int  i, j;
	unsigned long long fact;		//initializing fact to store large numbers
	
	for(i=1;i<=10;i++)		//factorial ranges from 1 to 10
	{
		fact=1;
		for(j=i;j>=1;j--)
		{
			fact=fact*j;	//calculating factorial for all the numbers in 1-10
		}
		
		printf("Factorial of %d is %d\n", i, fact); //printing factorrial
	}

	return 0;
}
