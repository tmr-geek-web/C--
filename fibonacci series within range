#include<stdio.h>
int main()
{
    int f1 = 1, f2 = 1, f3;

    printf("%d\n", f1);		//printing the initial values
    printf("%d\n", f2);

    while(1)
    {
        f3 = f1 + f2;

        if(f3 > 100)   // stopping the loop for number above 100
            break;

        printf("%d\n", f3);		//printing fibonacci series

        f1 = f2;
        f2 = f3;
    }

    return 0;
}
