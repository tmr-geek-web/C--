#include<stdio.h>
int main()
{
	
	int m; 
	
	printf("Enter marks of students:");		//taking marks as input
	scanf("%d", &m);
	
	//checking grade for marks entered 
	
	if(m>=90 && m<=100)
	{
		printf("A++:Outstanding");
	}
	else if(m>=80 && m<90)
	{
		printf("A+:Excellent");
	}
	else if(m>=70 && m<80)
	{
		printf("B:Very good");
	}
	else if(m>=60 && m<70)
	{
		printf("C:Good");
	}
	else if(m>=50 && m<60)
	{
		printf("D:Average");
	}
	else if(m>=40 && m<50)
	{
		printf("E:Satisfactory");
	}
	else
	{
		printf("F:Below satisfactory level!");
	}
	
	return 0;
}
