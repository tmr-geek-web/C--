#include<stdio.h>
int main()
{
	int i;
	
	//printing ASCII values and associated uppercase alphabets 
	for(i=65; i<=90; i++)
	{
		printf("%d - %c\n", i, char(i));
	}
	
	
	//printing ASCII values and associated lowercase alphabets 	
	for(i=97; i<=122; i++)
	{
		printf("%d - %c\n", i, char(i));		
	}
	
	return 0;
}
