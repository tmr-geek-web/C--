#include<stdio.h>
int main()
{
	int n, i, fact=1;
	
	printf("Enter a number:");		//taking input of the number
	scanf("%d", &n);
	
	if(n<=0)			//factorial holds only for positive integers
	{
		printf("Factorial does'nt hold!"); 
		
	}
	else
	{
		for(i=n;i>=1;i--)
		{
			fact*=i;	//calculaing its factorial
		}


	printf("Factorial of %d is %d", n, fact);	//printing the factorial
}
	
	return 0;
}
