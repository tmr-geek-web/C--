#include<stdio.h>
#include<math.h>

int main()
{
    int a, b, c;
    float d, x, y;

    printf("Enter the values of coefficients a, b, c: ");
    scanf("%d %d %d", &a, &b, &c);

    if(a == 0)
    {
        printf("a cannot be zero for a quadratic equation.\n");
    }
    else
    {
        d = (b*b) - (4*a*c);   // discriminant

        if(d < 0)
        {
            printf("The roots are complex (imaginary).\n");
        }
        else if(d == 0)
        {
            x = -b / (2.0 * a);
            printf("The roots are real and equal: %f\n", x);
            		//printing the roots
        }
        else
        {
            x = (-b + sqrt(d)) / (2*a);
            y = (-b - sqrt(d)) / (2*a);
            printf("The quadratic equation is %d x^2 + %d x + %d\n", a, b, c);
            		//printing the quadratic equation
            		
            printf("The roots are real and distinct: %f and %f\n", x, y);
            		//printing the roots
        }
    }

    return 0;
}
